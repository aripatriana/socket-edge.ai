<configuration>

    <!-- ================= PROPERTIES ================= -->
    <property name="LOG_HOME" value="${LOG_HOME:-../log}" />
    <property name="APP_NAME" value="socket-edge" />

    <!-- ================= NORMAL FILE APPENDER ================= -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/${APP_NAME}.log</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>
                ${LOG_HOME}/${APP_NAME}.%d{yyyy-MM-dd}.log
            </fileNamePattern>
            <maxFileSize>500MB</maxFileSize>
            <maxHistory>14</maxHistory>
        </rollingPolicy>

        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n
            </pattern>
        </encoder>
    </appender>

    <!-- ================= ERROR FILE APPENDER ================= -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/${APP_NAME}.err</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>
                ${LOG_HOME}/${APP_NAME}.%d{yyyy-MM-dd}.err
            </fileNamePattern>
            <maxFileSize>500MB</maxFileSize>
            <maxHistory>30</maxHistory>
        </rollingPolicy>

        <!-- FILTER: ONLY ERROR -->
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>

        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n
            </pattern>
        </encoder>
    </appender>

    <!-- ================= CONSOLE ================= -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>
                %d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n
            </pattern>
        </encoder>
    </appender>

    <!-- ================= AUDIT FILE APPENDER ================= -->
    <!--
        Encoder pakai %msg%n saja — AuditLogger sudah menghasilkan JSON lengkap.
        Tidak perlu prefix timestamp/level dari logback.
    -->
    <appender name="AUDIT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/audit.jsonl</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/audit.%d{yyyy-MM-dd}.jsonl</fileNamePattern>
            <maxHistory>90</maxHistory>
        </rollingPolicy>

        <encoder>
            <pattern>%msg%n</pattern>
        </encoder>
    </appender>

    <!-- ================= ASYNC AUDIT APPENDER ================= -->
    <!--
        neverBlock=true  : non-blocking, drop jika queue penuh (konsisten dengan
                           perilaku offer() sebelumnya).
        discardingThreshold=0 : jangan discard INFO saat queue 80% penuh
                                (default logback buang TRACE/DEBUG/INFO di titik ini).
        queueSize=10000  : sama dengan kapasitas queue lama.
    -->
    <appender name="ASYNC_AUDIT" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>10000</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>true</neverBlock>
        <appender-ref ref="AUDIT_FILE"/>
    </appender>

    <!-- ================= AUDIT LOGGER ================= -->
    <!--
        additivity=false : entry audit tidak ikut naik ke root logger,
                           sehingga tidak double-write ke FILE/CONSOLE.
    -->
    <logger name="audit" level="INFO" additivity="false">
        <appender-ref ref="ASYNC_AUDIT"/>
    </logger>

    <!-- ================= ROOT ================= -->
    <root level="INFO">
        <appender-ref ref="FILE"/>
        <appender-ref ref="ERROR_FILE"/>
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>